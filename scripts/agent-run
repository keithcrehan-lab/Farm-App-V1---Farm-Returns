#!/usr/bin/env bash
# Token-efficient autonomous run of ONE CURRENT_TASK. Deterministic: no model
# makes an orchestration decision. It only composes the existing scripts,
# whose safeguards stay authoritative:
#
#   PRECHECK → agent-build → agent-audit --primary → CLOSE              2 calls
#     primary Critical/High → agent-fix → agent-audit --final → CLOSE     4 calls
#     final Critical/High   → agent-fix → agent-audit --final → CLOSE     6 calls (hard max)
#     still Critical/High   → HUMAN_DECISION_REQUIRED (REPEATED_HIGH_FINDING)
#
# Medium/Low findings are recorded, never fixed or re-audited automatically.
# No remediation audits. A clean primary audit covers the complete task delta
# at the closing HEAD, so it is the task's final audit and is not repeated.
# The stage is persisted after every step (.agent/history/run-state-<task>.json);
# rerunning resumes at the next safe step and never repeats a successful
# model call. Verification follows the category policy in agent-runstate.py.
#
#   scripts/agent-run [--dry-run] [--full-tests] [--max-fix-rounds 1|2] [--no-auto-commit]
#
# Exit: 0 COMPLETE · 1 HUMAN_DECISION_REQUIRED · 2 usage · 3 another runner
#       is live · 130 interrupted (rerun to resume).
# Local commits only: the underlying scripts' checkpoints, plus the runner's
# own recovery commit of verified work (disabled by --no-auto-commit).
# Nothing here publishes, deploys or touches a database.
source "$(dirname "${BASH_SOURCE[0]}")/agent-lib.sh"
SCRIPTS="$REPO_ROOT/scripts"
rs() { python3 "$SCRIPTS/agent-runstate.py" "$@"; }
usage() { echo "usage: scripts/agent-run [--dry-run] [--full-tests] [--max-fix-rounds 1|2] [--no-auto-commit]" >&2; exit 2; }

DRY=false; FULL=false; MAXFIX=2; AUTO=true
while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run) DRY=true;;
    --full-tests) FULL=true;;
    --no-auto-commit) AUTO=false;;
    --max-fix-rounds) [[ "${2:-}" == 1 || "${2:-}" == 2 ]] || usage; MAXFIX="$2"; shift;;
    *) usage;;
  esac
  shift
done
[[ -z "${MAX_FIX_ROUNDS+x}" ]] || { echo "agent-run: MAX_FIX_ROUNDS is retired; use --max-fix-rounds 1|2" >&2; exit 2; }

if $DRY; then
  out="$( { require_task && python3 "$SCRIPTS/agent-runstate.py" dry-run "$FULL" "$MAXFIX"; } 2>&1 )" || {
    printf '%s\n' "$out"; echo "agent-run: dry run pre-flight failed (no model call)" >&2; exit 1; }
  printf '%s\n' "$out"; exit 0
fi

RUN_ID="$(stamp)"
STATE_READY=false; FINISHED=false; PHASE="precheck"; LOCKED=false; PRE_OUT=""; PHASE_RESULT=""
LOGDIR="$HISTORY_DIR"

# human REASON DETAIL NEXT [resumable] — the only way a run stops short of COMPLETE.
human() {
  local reason="$1" detail="$2" next="$3" resumable="${4:-false}"
  FINISHED=true
  if $STATE_READY; then
    rs finish HUMAN_DECISION_REQUIRED "$reason" "$detail" "$next" "$resumable" || true
  else
    echo "AGENT_RUN_RESULT: HUMAN_DECISION_REQUIRED"
    echo "REASON: $reason"
    printf '%s\n' "$detail" | head -n3 | sed 's/^/DETAIL: /'
    echo "NEXT_RECOMMENDED_ACTION: $next"
    echo "Model calls: 0"
  fi
  exit 1
}

on_interrupt() {
  trap - INT TERM; FINISHED=true
  echo
  echo "AGENT_RUN_RESULT: INTERRUPTED during $PHASE"
  echo "Not COMPLETE. Progress is saved; rerun ./scripts/agent-run to resume (./scripts/agent-status shows where it stands)."
  exit 130
}
on_exit() {
  local rc=$?
  $LOCKED && rs lock release "$$" 2>/dev/null || true
  $FINISHED && return 0
  echo "AGENT_RUN_RESULT: ABORTED during $PHASE (unexpected exit $rc). Not COMPLETE. Check ./scripts/agent-status." >&2
}
trap on_interrupt INT TERM
trap on_exit EXIT

# ── lock: one runner per worktree; a model never resolves it ───────────
lrc=0; lmsg="$(rs lock acquire "$$" "$RUN_ID")" || lrc=$?
case "$lrc" in
  0) LOCKED=true;;
  3) FINISHED=true; echo "AGENT_RUN_RESULT: RUNNER_ACTIVE"; echo "DETAIL: $lmsg"; echo "Model calls: 0"; exit 3;;
  *) human LOCK_INDETERMINATE "$lmsg" "confirm no agent-run is active, then remove $HISTORY_DIR/agent-run.lock";;
esac

# ── PRECHECK: shell/local only, before any model call ──────────────────
fail_pre() { human PRECHECK_FAILED "$1" "${2:-fix the precheck condition, then rerun ./scripts/agent-run}"; }
pre="$( { require_task && require_not_main; } 2>&1 )" || fail_pre "${pre##*agent: }"
[[ -f "$AGENT_DIR/TASK.json" ]] || fail_pre "missing $AGENT_DIR/TASK.json"
for s in agent-build agent-audit agent-fix; do [[ -x "$SCRIPTS/$s" ]] || fail_pre "missing or non-executable scripts/$s"; done
for s in agent-lib.sh agent-context.py agent-runstate.py; do [[ -f "$SCRIPTS/$s" ]] || fail_pre "missing scripts/$s"; done
BASE="$(python3 "$SCRIPTS/agent-context.py" pin 2>&1)" || fail_pre "task metadata/immutable base lock invalid: ${BASE##*: }"
TASK_ID="$(rs task-id 2>&1)" || fail_pre "task metadata does not parse: $TASK_ID"
STATE_PATH="$(rs state-path)"
export AGENT_RUN_STATE="$STATE_PATH"
BRANCH="$(git branch --show-current)"
TITLE="$(task_title)"
TASK_PIN="$(git hash-object "$TASK_FILE")"

if [[ ! -f "$STATE_PATH" ]]; then
  pre="$(require_clean 2>&1)" || fail_pre "${pre##*agent: }"
  [[ "$(git rev-parse HEAD)" == "$BASE" ]] ||
    fail_pre "HEAD $(short HEAD) is not the task base $(short "$BASE"): the task already has commits" "continue manually with the agent-* scripts, or start a new task ID"
  prior="$(state_get stage)"
  if [[ "$(state_get task)" == "$TITLE" && -n "$prior" && "$prior" != idle ]]; then
    fail_pre "STATE.md shows this task in progress (stage '$prior') without an agent-run state" "continue manually with the agent-* scripts"
  fi
  rs init "$RUN_ID" "$BRANCH" "$FULL" "$MAXFIX" "$AUTO" >/dev/null
  STATE_READY=true
  echo "agent-run $RUN_ID: task $TASK_ID from $(short "$BASE")"
else
  STATE_READY=true
  result="$(rs get result)"
  if [[ "$result" == COMPLETE ]]; then
    # COMPLETE only holds for the exact audited HEAD on the run's branch with a clean tree.
    # STATE_READY=false: a later change must not overwrite the recorded completion.
    STATE_READY=false
    [[ "$(rs get branch)" == "$BRANCH" ]] || human UNEXPECTED_STATE_CHANGE "completed run is on branch $(rs get branch), now on $BRANCH" "return to the run's branch"
    [[ "$(git rev-parse HEAD)" == "$(rs get head)" ]] ||
      human UNEXPECTED_STATE_CHANGE "HEAD $(short HEAD) is not the audited closing HEAD $(short "$(rs get head)")" "audit the new commits in a new task; they are not covered by this run"
    # The whole non-ignored tree, .agent/ included: require_clean deliberately skips .agent/.
    dirty="$(git status --porcelain --untracked-files=all)"
    [[ -z "$dirty" ]] || human UNEXPECTED_STATE_CHANGE "working tree has changes not covered by the completed run: $(printf '%s\n' "$dirty" | head -n3 | tr '\n' ' ')" "inspect the working tree; it is not covered by the completed run"
    why="$(rs completion-check 2>&1)" || human UNEXPECTED_STATE_CHANGE "completion no longer valid — ${why#agent-runstate: }" "inspect the named audit; the completed run does not cover it"
    FINISHED=true; rs report; echo "(already complete — no model call)"; exit 0
  fi
  if [[ "$result" == HUMAN_DECISION_REQUIRED && "$(rs get resumable)" != true ]]; then
    FINISHED=true; rs report
    echo "(stopped earlier; resolve it, then delete $STATE_PATH to start this task's run afresh)"; exit 1
  fi
  [[ "$(rs get branch)" == "$BRANCH" ]] || { STATE_READY=false; human UNEXPECTED_STATE_CHANGE "saved run is on branch $(rs get branch), now on $BRANCH" "return to the run's branch"; }
  inflight="$(rs get in_flight)"
  if [[ "$inflight" != build && "$inflight" != fix ]]; then
    pre="$(require_clean 2>&1)" || human UNEXPECTED_STATE_CHANGE "${pre##*agent: }" "inspect the working tree; agent-run never discards work"
    [[ "$(git rev-parse HEAD)" == "$(rs get head)" ]] ||
      human UNEXPECTED_STATE_CHANGE "HEAD $(short HEAD) is not the run's last step $(short "$(rs get head)")" "inspect the new commits; continue manually with the agent-* scripts"
  fi
  rs resume
  MAXFIX="$(rs get options.max_fix_rounds)"; AUTO="$(rs get options.auto_commit)"
  echo "agent-run: resuming task $TASK_ID at stage $(rs get stage)${inflight:+ (interrupted during $inflight)}"
fi

# ── helpers ────────────────────────────────────────────────────────────
check_task() {
  [[ -f "$TASK_FILE" && "$(git hash-object "$TASK_FILE")" == "$TASK_PIN" ]] ||
    human TASK_SCOPE_EXPANSION_REQUIRED "CURRENT_TASK.md changed during $PHASE" "restore the task text; scope/verify command must not change mid-run"
}
check_tree() {
  [[ "$(git branch --show-current)" == "$BRANCH" ]] || human UNEXPECTED_STATE_CHANGE "branch changed during $PHASE" "return to $BRANCH"
  [[ -z "$(dirty_paths)" ]] || human UNEXPECTED_STATE_CHANGE "unexpected working-tree changes after $PHASE: $(dirty_paths | head -n3 | tr '\n' ' ')" "inspect the working tree"
}
budget() { # budget KEY LIMIT
  (( $(rs get "completed.$1") < $2 )) || human BUDGET_EXHAUSTED "$1 budget of $2 call(s) already used" "review ./scripts/agent-status and decide"
}
gate_reason() { rs reason "$1" "$2"; }

# recover KIND PREV RESULT — uncommitted agent work is coherent: verify it
# (cached results reused) and make the normal local checkpoint commit.
recover() {
  local kind="$1" prev="$2" res="$3" msg why
  [[ "$AUTO" == true ]] || human AGENT_OUTPUT_AMBIGUOUS "$kind left uncommitted work; --no-auto-commit forbids the runner's recovery commit" "review the working tree, then commit or discard it yourself"
  [[ "$(git branch --show-current)" == "$BRANCH" && "$(git rev-parse HEAD)" == "$prev" ]] ||
    human AGENT_OUTPUT_AMBIGUOUS "HEAD or branch moved during $kind" "inspect git log and the working tree"
  [[ -n "$(dirty_paths)" ]] || human AGENT_OUTPUT_AMBIGUOUS "$kind ended without a result and without changes" "rerun the phase manually (scripts/agent-$kind)"
  why="$(rs coherent 2>&1)" || human AGENT_OUTPUT_AMBIGUOUS "${why##*: }" "resolve the working tree by hand"
  why="$(python3 "$SCRIPTS/agent-context.py" pin 2>&1 >/dev/null)" || human TASK_SCOPE_EXPANSION_REQUIRED "task boundary changed: ${why##*: }" "restore the task files"
  if ! AGENT_PHASE="$kind" run_verify >>"$LOGDIR/run-$RUN_ID-recover.log" 2>&1; then
    local g; g="$(rs get verify_gate)"
    [[ -n "$g" ]] && human "$g" "$kind changed files that need explicit authority" "authorise the change in a dedicated task"
    human VERIFICATION_FAILED "verification failed for recovered $kind work — see $LOGDIR/run-$RUN_ID-recover.log" "fix the failure or discard the edits yourself"
  fi
  if [[ "$kind" == build ]]; then msg="Agent checkpoint (build): $TITLE"
  else msg="Agent checkpoint (fix): $TITLE — findings from $(basename "$(state_get last_audit)")"; fi
  why="$( (checkpoint_commit "$msg") 2>&1 )" || human AGENT_OUTPUT_AMBIGUOUS "recovery commit refused: ${why##*agent: }" "review the staged changes yourself"
  if [[ "$kind" == build ]]; then state_set stage built; else state_set stage fixed; state_set fix_base "$prev"; fi
  state_set blockers none; state_touch
  echo "  recovered: verified and committed $(short HEAD) locally ($res)"
  PHASE_RESULT="$res"
}

# settle KIND WANT_STAGE PREV RC LOG — classify a build/fix outcome mechanically.
settle() {
  local kind="$1" want="$2" prev="$3" rc="$4" log="$5" stage out result head up
  stage="$(state_get stage)"; head="$(git rev-parse HEAD)"; up="$(echo "$kind" | tr a-z A-Z)"
  out="$(state_get "last_$kind")"
  # An output path left over from an earlier phase is not this phase's verdict.
  [[ $rc -eq 99 || "$out" != "$PRE_OUT" ]] || out=""
  check_task
  if [[ "$stage" == "$want" && "$head" != "$prev" && "$(git rev-parse "$head^")" == "$prev" ]]; then
    [[ $rc -eq 0 || $rc -eq 99 ]] || human AGENT_OUTPUT_AMBIGUOUS "$kind committed but exited $rc — see $log" "inspect the checkpoint commit"
    if [[ -n "$out" && -f "$out" ]] && has_stop_marker "$out"; then
      human "$(gate_reason "$(first_stop_marker "$out")" AGENT_STOP)" "$(first_stop_marker "$out")" "answer the STOP condition in $out"
    fi
    check_tree; PHASE_RESULT=DONE; return 0
  fi
  [[ "$head" == "$prev" ]] || human UNEXPECTED_STATE_CHANGE "HEAD moved unexpectedly during $kind" "inspect git log"
  if [[ -n "$out" && -f "$out" ]] && has_stop_marker "$out"; then
    human "$(gate_reason "$(first_stop_marker "$out")" AGENT_STOP)" "$(first_stop_marker "$out")" "answer the STOP condition in $out"
  fi
  result="$( [[ -n "$out" && -f "$out" ]] && last_marker BUILD_RESULT "$out" || true)"
  case "$stage" in
    *verify-failed)
      local g; g="$(rs get verify_gate)"
      [[ -n "$g" ]] && human "$g" "$kind changed files that need explicit authority (category $(rs get category))" "authorise the change in a dedicated task"
      human VERIFICATION_FAILED "verification failed after $kind — edits left in the tree ($log)" "fix the failure or discard the edits yourself";;
    *noop) human "$(gate_reason "$result" "${up}_BLOCKED")" "$kind reported DONE but changed nothing — $out" "read $out and decide";;
  esac
  if [[ -n "$log" ]] && grep -qE '^agent: claude timed out|not DONE \(exit 124' "$log" 2>/dev/null; then
    human AGENT_OUTPUT_AMBIGUOUS "$kind timed out; partial edits may remain" "review the working tree"
  fi
  if [[ "$result" == BLOCKED* && "$result" != *"invalid CLI JSON"* ]]; then
    human "$(gate_reason "$result" "${up}_BLOCKED")" "$kind: $result" "resolve the blocker in $out"
  fi
  if [[ -z "$result" || "$result" == *"invalid CLI JSON"* ]]; then
    # No agent verdict (wrapper/background process ended oddly). The agent's own
    # BLOCKED/STOP text in the raw output still wins.
    if [[ -n "$out" && -f "$out.json" ]] && grep -qE 'BUILD_RESULT: BLOCKED|(^|\\n)STOP[: ]' "$out.json"; then
      human AGENT_OUTPUT_AMBIGUOUS "$kind output is unparseable but mentions BLOCKED/STOP — $out.json" "read the raw output and decide"
    fi
    recover "$kind" "$prev" DONE_RECOVERED; return 0
  fi
  if [[ "$result" == DONE* ]]; then recover "$kind" "$prev" DONE_COMMIT_RECOVERED; return 0; fi
  human AGENT_OUTPUT_AMBIGUOUS "$kind ended in stage '$stage' (exit $rc) — see $log" "inspect $log"
}

do_build() {
  local prev log="" rc=99; PHASE=BUILD; prev="$(rs get head)"; PRE_OUT="$(state_get last_build)"
  if [[ "$(rs get in_flight)" != build ]]; then
    budget build 1
    rs begin build
    log="$LOGDIR/run-$RUN_ID-build.log"; rs append logs "$log"
    echo "[BUILD] scripts/agent-build"
    rc=0; "$SCRIPTS/agent-build" >"$log" 2>&1 || rc=$?
  else
    echo "[BUILD] interrupted earlier — inspecting local state (no model call)"
  fi
  settle build built "$prev" "$rc" "$log"
  rs set report_paths.build "$(state_get last_build)"
  rs complete build BUILD_DONE "$(git rev-parse HEAD)" "$PHASE_RESULT"
  echo "  $PHASE_RESULT -> $(short HEAD)"
}

do_fix() { # do_fix N
  local n="$1" prev log="" rc=99; PHASE="FIX $n"; prev="$(rs get head)"; PRE_OUT="$(state_get last_fix)"
  if [[ "$(rs get in_flight)" != fix ]]; then
    budget fix "$MAXFIX"
    rs begin fix
    log="$LOGDIR/run-$RUN_ID-fix-$n.log"; rs append logs "$log"
    echo "[FIX $n] scripts/agent-fix"
    rc=0; AGENT_PHASE=fix "$SCRIPTS/agent-fix" >"$log" 2>&1 || rc=$?
  else
    echo "[FIX $n] interrupted earlier — inspecting local state (no model call)"
  fi
  settle fix fixed "$prev" "$rc" "$log"
  rs append fix "$(state_get last_fix)"
  rs complete fix "FIX_${n}_DONE" "$(git rev-parse HEAD)" "$PHASE_RESULT"
  echo "  $PHASE_RESULT -> $(short HEAD)"
}

# do_audit KIND(full|final) KEY NEXT_STAGE LABEL
do_audit() {
  local kind="$1" key="$2" next="$3" label="$4" head art res summary counts line2 rc=0 adopted=false log before
  PHASE="$label"; head="$(git rev-parse HEAD)"; art="$(state_get last_audit)"
  # An assessed audit of exactly this kind and HEAD not yet recorded (e.g. it
  # finished just before an interruption, or a manual retry) is adopted, not repeated.
  if [[ "$(state_get last_audit_kind)" == "$kind" && "$(state_get last_audit_head)" == "$head" && -n "$art" && -f "$art" ]] &&
     ! rs consumed "$art" && [[ "$(state_get last_audit_result)" != UNASSESSED* ]] && audit_output_valid "$art"; then
    adopted=true; echo "[$label] adopting existing audit $art (no model call)"
  else
    budget "$key" "$([[ $key == primary_audit ]] && echo 1 || echo "$MAXFIX")"
    rs begin "$key"
    log="$LOGDIR/run-$RUN_ID-$key-$(rs get "model_calls.$key").log"; rs append logs "$log"
    before="$art"
    echo "[$label] scripts/agent-audit --$([[ $kind == full ]] && echo primary || echo final)"
    "$SCRIPTS/agent-audit" "--$([[ $kind == full ]] && echo primary || echo final)" >"$log" 2>&1 || rc=$?
    art="$(state_get last_audit)"; res="$(state_get last_audit_result)"
    if [[ "$res" == UNASSESSED* ]]; then
      rs set in_flight ""
      human AUDIT_UNASSESSED "audit UNASSESSED ($res) — not a pass; see $art" "retry: rerun ./scripts/agent-run (resumes at this audit)" true
    fi
    [[ $rc -eq 0 || $rc -eq 1 ]] || { rs set in_flight ""; human AUDIT_UNASSESSED "agent-audit exited $rc — see $log" "fix the cause, then rerun ./scripts/agent-run" true; }
    [[ -n "$art" && -f "$art" && "$art" != "$before" ]] || human AUDIT_UNASSESSED "agent-audit wrote no new audit artifact — see $log" "rerun ./scripts/agent-run" true
    [[ "$(state_get last_audit_kind)" == "$kind" ]] || human UNEXPECTED_STATE_CHANGE "audit kind is '$(state_get last_audit_kind)', expected '$kind'" "inspect $log"
  fi
  rs append audits "$art"
  res="$(state_get last_audit_result)"; summary="${res% @ *}"
  counts="$(audit_counts "$summary")" || human AUDIT_UNASSESSED "audit result '$res' cannot be parsed reliably — see $art" "rerun ./scripts/agent-audit" true
  line2="$(sed -n 2p "$art")"
  if [[ "$line2" != *"verdict: ASSESSED"* || "$line2" != *"..$head "* || "$(last_marker AUDIT_SUMMARY "$art")" != "$summary" ]] ||
     ! audit_output_valid "$art"; then
    human AUDIT_UNASSESSED "audit artifact $art does not match STATE.md ('$res') or HEAD $(short "$head")" "rerun the audit" true
  fi
  read -r C H M L <<<"$counts"
  # An explicit STOP in the audit outranks its counts: never closed, never auto-fixed.
  if has_stop_marker "$art"; then
    human "$(gate_reason "$(first_stop_marker "$art")" AUDIT_STOP)" "$(first_stop_marker "$art") — $art" "review $art and decide"
  fi
  if ! $adopted && { { [[ $rc -eq 0 ]] && (( C + H > 0 )); } || { [[ $rc -eq 1 ]] && (( C + H == 0 )); }; }; then
    human AUDIT_UNASSESSED "agent-audit exit $rc is inconsistent with '$summary'" "rerun the audit" true
  fi
  [[ "$(git rev-parse HEAD)" == "$head" ]] || human UNEXPECTED_STATE_CHANGE "HEAD moved during the audit" "inspect git log"
  check_tree; check_task
  rs audit-done "$key" "$next" "$art" "$head" "$C $H $M $L" "$adopted"
  echo "  CRITICAL=$C HIGH=$H MEDIUM=$M LOW=$L"
}

closeout() {
  local why; PHASE=CLOSEOUT
  why="$(rs closeout 2>&1)" || human UNEXPECTED_STATE_CHANGE "closeout refused — ${why#agent-runstate: }" "inspect the named audit and ./scripts/agent-status"
  state_set last_completed_task "$TITLE @ $(short HEAD)"; state_set task_head "$(git rev-parse HEAD)"
  state_set stage complete; state_set blockers none; state_touch
  FINISHED=true
  rs finish COMPLETE "" "" "" false
  exit 0
}

blocking() { (( $(rs get findings.critical) + $(rs get findings.high) > 0 )); }

# ── the run: resume from the persisted stage, never repeat a completed call ──
while :; do
  case "$(rs get stage)" in
    PRECHECK_DONE) do_build;;
    BUILD_DONE) do_audit full primary_audit PRIMARY_DONE "PRIMARY AUDIT";;
    PRIMARY_DONE) if blocking; then do_fix 1; else closeout; fi;;
    FIX_1_DONE) do_audit final final_audit FINAL_1_DONE "FINAL AUDIT 1";;
    FINAL_1_DONE)
      if ! blocking; then closeout; fi
      (( MAXFIX >= 2 )) || human REPEATED_HIGH_FINDING "Critical/High remain after 1 fix round — $(state_get last_audit)" "review the findings and decide"
      do_fix 2;;
    FIX_2_DONE) do_audit final final_audit FINAL_2_DONE "FINAL AUDIT 2";;
    FINAL_2_DONE)
      if ! blocking; then closeout; fi
      human REPEATED_HIGH_FINDING "Critical/High remain after 2 fix rounds — $(state_get last_audit)" "review the findings and decide; no third automatic round";;
    CLOSEOUT_DONE)
      PHASE=CLOSEOUT; why="$(rs completion-check 2>&1)" ||
        human UNEXPECTED_STATE_CHANGE "completion no longer valid — ${why#agent-runstate: }" "inspect the named audit and ./scripts/agent-status"
      FINISHED=true; rs finish COMPLETE "" "" "" false; exit 0;;
    *) human UNEXPECTED_STATE_CHANGE "unknown saved stage '$(rs get stage)'" "inspect $STATE_PATH";;
  esac
done
