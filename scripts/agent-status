#!/usr/bin/env bash
# Concise workflow status. Completely local and read-only: no AI invocation,
# no network, no file writes (not even STATE.md defaults).
set -euo pipefail
cd "$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel)"

python3 scripts/agent-runstate.py status

branch="$(git branch --show-current || true)"
dirty="clean"
n="$(git status --porcelain --untracked-files=all -- . ':(exclude).agent' | wc -l | tr -d ' ')"
[[ "$n" == 0 ]] || dirty="DIRTY ($n paths outside .agent/)"
legacy="$(sed -n 's/^stage: \{0,1\}//p' .agent/STATE.md 2>/dev/null | head -n1 || true)"
echo
echo "Branch: ${branch:-(detached)} · tree $dirty · STATE.md stage: ${legacy:-(none)}"
