# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Farm Return Next — autopilot/audit run artefacts (ephemeral; the durable
# record is docs/farm-return-next/IMPLEMENTATION_LOG.md, updated by hand
# alongside the commit each run produces)
/docs/farm-return-next/audit-logs/
/docs/farm-return-next/autopilot-logs/
/docs/farm-return-next/.quality-gate-last.json
/docs/farm-return-next/.autopilot-stop

# Supabase CLI local link/session state (npx supabase link) -- never
# committed; contains no secret but is per-machine CLI cache, not
# project source.
supabase/.temp/
