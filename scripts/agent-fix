#!/usr/bin/env bash
# Fix stage: Claude fixes the findings in the latest ASSESSED audit (by
# default Critical/High; --all also covers Medium/Low), with a regression
# test per defect. This script independently runs the verify command, then
# makes a LOCAL checkpoint commit. Never pushes. Exits cleanly (0) when
# there's nothing to fix.
#
#   scripts/agent-fix [--all] [--another-round] [--dry-run]
#   scripts/agent-fix --only F001,F002 --audit PATH [--expect-head SHA] [--dry-run]
#   --another-round   explicit human approval to fix after a *verification*
#                     audit still found Critical/High (AGENTS.md: never automatic)
#   --only IDS        narrow remediation: exactly the named Critical/High/Medium findings of
#                     the pinned audit (Low is never selectable); nothing else is fixed
#   --audit PATH      required with --only: must be the latest recorded audit (no stale pin)
#   --expect-head SHA refuse unless HEAD is exactly SHA
source "$(dirname "${BASH_SOURCE[0]}")/agent-lib.sh"

USAGE="usage: agent-fix [--all] [--another-round] [--dry-run] | --only IDS --audit PATH [--expect-head SHA] [--dry-run]"
ALL=false; AGAIN=false; DRY=false; ONLY=""; PIN=""; EXPECT=""
while [[ $# -gt 0 ]]; do
  case "$1" in --all) ALL=true;; --another-round) AGAIN=true;; --dry-run) DRY=true;;
    --only) ONLY="${2:-}"; [[ -n "$ONLY" ]] || die "$USAGE"; shift;;
    --audit) PIN="${2:-}"; [[ -n "$PIN" ]] || die "$USAGE"; shift;;
    --expect-head) EXPECT="${2:-}"; [[ -n "$EXPECT" ]] || die "$USAGE"; shift;;
    *) die "$USAGE";; esac
  shift
done
if [[ -n "$ONLY" ]]; then
  $ALL && die "--only and --all are mutually exclusive"
  [[ -n "$PIN" ]] || die "--only requires --audit PATH (the exact audit artifact is pinned)"
  [[ "$ONLY" =~ ^[A-Za-z]+[0-9]+(,[A-Za-z]+[0-9]+)*$ ]] || die "--only takes finding IDs such as F001,F002"
elif [[ -n "$PIN" || -n "$EXPECT" ]]; then
  die "--audit/--expect-head are only used with --only"
fi
MODEL_ARGS=(); [[ -n "${AGENT_CLAUDE_MODEL:-}" ]] && MODEL_ARGS=(--model "$AGENT_CLAUDE_MODEL")

require_cli claude
require_task
require_not_main
require_clean
python3 scripts/agent-context.py pin >/dev/null
CONTEXT="$(python3 scripts/agent-context.py context)"
export AGENT_PHASE=fix

audit="$(state_get last_audit)"; kind="$(state_get last_audit_kind)"; res="$(state_get last_audit_result)"
[[ -n "$audit" && -f "$audit" ]] || die "no audit result recorded — run scripts/agent-audit first"
[[ "$res" != UNASSESSED* ]] || die "latest audit is UNASSESSED — re-run scripts/agent-audit; unassessed is never a basis for fixes"
[[ "$(state_get stage)" != fixed ]] || die "fixes already committed for $audit — run scripts/agent-audit (focused verification) next"

[[ "$(state_get last_audit_head)" == "$(git rev-parse HEAD)" ]] || die "stale audit: HEAD changed since the finding was assessed"
[[ -z "$EXPECT" || "$(git rev-parse HEAD)" == "$(git rev-parse --verify -q "$EXPECT^{commit}" || true)" ]] || die "HEAD is not the expected $EXPECT"
[[ -z "$PIN" || "$PIN" == "$audit" ]] || die "pinned audit $PIN is not the latest recorded audit $audit (stale pin)"
[[ "$(state_get task_base)" == "$(python3 scripts/agent-context.py pin)" ]] || die "audit belongs to a different task"
audit_output_valid "$audit" || die "invalid finding artifact"
has_stop_marker "$audit" && die "audit contains STOP: human review required"

count() { echo "$res" | sed -n "s/.*$1=\([0-9][0-9]*\).*/\1/p"; }
c="$(count CRITICAL)"; h="$(count HIGH)"; m="$(count MEDIUM)"; l="$(count LOW)"
blocking=$(( ${c:-0} + ${h:-0} )); minor=$(( ${m:-0} + ${l:-0} ))
if [[ -z "$ONLY" && $blocking -eq 0 ]] && { ! $ALL || [[ $minor -eq 0 ]]; }; then
  note "no findings to fix in $audit ($res). Nothing to do."; exit 0
fi
if [[ "$kind" == verify && $blocking -gt 0 ]] && ! $AGAIN; then
  die "the verification audit still has Critical/High. A further round needs explicit approval: re-run with --another-round"
fi

levels="CRITICAL and HIGH"; $ALL && levels="all (CRITICAL, HIGH, MEDIUM, LOW)"
if [[ -n "$ONLY" ]]; then
  levels="selected findings $ONLY"
  sel="${audit%.md}.selected-findings.md"
  n="$(python3 scripts/agent-context.py select-findings "$audit" "$sel" "$ONLY")" || die "cannot select findings $ONLY from $audit"
  FINDINGS="Selected findings: $sel (exactly $n finding(s) $ONLY extracted from $audit; read that file only for findings).
Fix ONLY the defect families represented by these selected findings; do not fix a different finding/family from the audit, and never Low findings. For each selected finding, read its INVARIANT and DEFECT_FAMILY, reproduce the cited example first, then search the authorised current-phase scope for sibling instances of that same family. Repair the class rather than only the cited line. Add a direct regression plus a class/property/metamorphic regression where practical. Do not refactor unrelated working code or broaden scope.
If a finding needs a human decision rather than a code repair (scientific, regulatory, veterinary, evidence, source precedence, product, migration, frozen-contract, scope, push/deploy, secrets or production access), change no code for it and print a line 'STOP: <REASON> <finding ID> <detail>' using the reason vocabulary in .agent/AUDIT_RULES.md."
elif $ALL; then
  FINDINGS="Read the audit findings in $audit. Fix the $levels findings only."
else
  # Send only the open Critical/High findings, not the audit history.
  open="${audit%.md}.open-findings.md"
  n="$(python3 scripts/agent-context.py open-findings "$audit" "$open")"
  if [[ "$n" -ge "$blocking" ]]; then
    FINDINGS="Open Critical/High findings: $open (extracted from $audit; read that file only for findings)."
  else
    FINDINGS="Read only the CRITICAL and HIGH findings in $audit."
  fi
  FINDINGS="$FINDINGS
Fix only the open Critical/High findings. Do not refactor unrelated code. Do not opportunistically resolve Medium/Low findings. Do not broaden scope."
fi
PROMPT="$CONTEXT
$FINDINGS
For each selected family: confirm the cited finding against the code first. If genuine, repair the whole family inside CURRENT_TASK scope and test both the cited regression and the class-wide invariant; inspect sibling sites before declaring it fixed. If a finding is wrong or not reproducible, don't change code for it — say why in one line.
Stay within CURRENT_TASK scope; no refactors beyond the fixes. Search/read only the files implicated by the findings and the contracts/evidence they require; don't narrate.
Never run git commit, push, reset, checkout, stash or clean. Do not edit .agent/CURRENT_TASK.md, .agent/TASK.json, .agent/STATE.md, docs/farm-return-next/BUILD_STATE.json, docs/farm-return-next/IMPLEMENTATION_LOG.md, campaign receipts/audit copies, secrets, .env*, or any Claude/Codex settings or hooks.
Finish with at most 10 lines: per finding FIXED/REJECTED + test name, tests run with actual results — then a final line exactly 'BUILD_RESULT: DONE' or 'BUILD_RESULT: BLOCKED <reason>'."

if $DRY; then
  note "fix pre-flight OK: audit=$audit ($res), levels=$levels"
  printf -- '--- prompt ---\n%s\n' "$PROMPT"; exit 0
fi

fix_base="$(git rev-parse HEAD)"
state_set stage fixing; state_touch
out="$HISTORY_DIR/fix-$(stamp).md"
note "claude fixing $levels findings from $audit (output: $out)"
rc=0; run_claude "$PROMPT" "$out" ${MODEL_ARGS[@]+"${MODEL_ARGS[@]}"} || rc=$?
tail -n 12 "$out"
state_set last_fix "$out"

result="$(last_marker BUILD_RESULT "$out")"
if [[ $rc -ne 0 || "$result" != DONE* ]]; then
  state_set stage fix-failed; state_set blockers "fix: exit $rc, ${result:-no BUILD_RESULT line} ($out)"; state_touch
  die "fix not DONE (exit $rc, ${result:-no BUILD_RESULT line}) — nothing committed; edits left in the tree for review"
fi
if [[ -z "$(dirty_paths)" ]]; then
  state_set stage fix-noop; state_touch
  die "claude changed nothing (every finding rejected?) — read $out and decide; nothing committed"
fi
python3 scripts/agent-context.py pin >/dev/null || die "task boundary changed"
if ! scope_err="$(campaign_scope_check_dirty 2>&1)"; then
  state_set stage fix-scope-failed; state_set blockers "$scope_err"; state_touch
  echo "$scope_err" >&2
  die "campaign pre-commit scope guard rejected the fix — nothing committed; edits left in the tree for review"
fi
if ! run_verify; then
  state_set stage fix-verify-failed; state_touch
  die "verify command failed — nothing committed; edits left in the tree for review"
fi

checkpoint_commit "Agent checkpoint (fix): $(task_title) — findings ${ONLY:+$ONLY }from $(basename "$audit")" || die "nothing to commit"
state_set fix_base "$fix_base"
state_set stage fixed
state_touch
note "committed $(short HEAD) locally (not pushed). Next: scripts/agent-audit (focused verification)"
