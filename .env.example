# Copy to .env.local and fill in real values. Never commit .env.local.

# Mapbox (field mapping) — already required by the Phase 1 UI prototype.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Supabase (Real Farm V1 — accounts + persistent farm database).
# Create a project at https://supabase.com/dashboard, then copy these from
# Project Settings -> API. See docs/real-farm-v1/BUILD_LOG.md (Phase 2) —
# without these set, the app runs with no auth gate and no persistence
# (src/lib/supabase/env.ts's isSupabaseConfigured() check fails open).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Base URL used to build Supabase email-confirmation/password-reset
# redirect links (src/app/actions/auth.ts). Defaults to
# http://localhost:3100 (this repo's dev server port) if unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3100
